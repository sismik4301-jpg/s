function Create-CosmicMetricBox {
    param ($Name, $XOffset, $Color)
    $panel = New-Object System.Windows.Forms.Panel
    $panel.Size = New-Object System.Drawing.Size(100, 65)
    $panel.Location = New-Object System.Drawing.Point((1220 - $XOffset), 38)
    $panel.BackColor = [System.Drawing.Color]::FromArgb(28, 24, 54)
    $panel.Anchor = [System.Windows.Forms.AnchorStyles]::Top -bor [System.Windows.Forms.AnchorStyles]::Right

    $nameLabel = New-Object System.Windows.Forms.Label
    $nameLabel.Text = $Name
    $nameLabel.Font = New-Object System.Drawing.Font("Segoe UI", 8.5, [System.Drawing.FontStyle]::Bold)
    $nameLabel.ForeColor = [System.Drawing.Color]::FromArgb(200, 190, 230)
    $nameLabel.TextAlign = "MiddleCenter"
    $nameLabel.Dock = "Top"
    $nameLabel.Height = 22

    $valLabel = New-Object System.Windows.Forms.Label
    $valLabel.Text = "0"
    $valLabel.Font = New-Object System.Drawing.Font("Segoe UI Semibold", 14, [System.Drawing.FontStyle]::Bold)
    $valLabel.ForeColor = $Color
    $valLabel.TextAlign = "MiddleCenter"
    $valLabel.Dock = "Fill"

    $panel.Controls.Add($valLabel)
    $panel.Controls.Add($nameLabel)
    $headerPanel.Controls.Add($panel)
    return $valLabel
}

